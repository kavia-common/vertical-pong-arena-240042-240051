# Vertical Pong Arena - Frontend environment variables
# Copy to .env and fill in values (do not commit secrets)

# Base URL for REST API (preferred)
REACT_APP_API_BASE=

# Alternative aliases sometimes used by deployments/backends
REACT_APP_BACKEND_URL=

# Frontend public URL (used for redirects / PWA scope if needed)
REACT_APP_FRONTEND_URL=

# WebSocket URL for real-time play (Socket.io)
REACT_APP_WS_URL=

# Environment / flags
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_PORT=3000
REACT_APP_NEXT_TELEMETRY_DISABLED=1
